# Backend environment variables
# Copy this file to .env and fill in values. Do not commit .env.

# Server port (optional, default: 3000)
PORT=3000

# JWT: required in production. Use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-change-in-production
# Token expiry (optional, default: 7d)
JWT_EXPIRES_IN=7d

# QR code signing for session check-in: required in production. Use a long random string.
QR_SECRET=your-qr-secret-change-in-production
