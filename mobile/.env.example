# Mobile (Expo) environment variables
# Copy this file to .env and fill in values. Do not commit .env.
# Only variables prefixed with EXPO_PUBLIC_ are available in the app.

# Backend API base URL (no trailing slash).
# Use localhost when running on same machine; use your machine IP or deployed URL when on device/emulator.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Google Sign-In (optional) ---
# Create OAuth clients in Google Cloud Console (Web + iOS + Android).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=....apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=....apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=....apps.googleusercontent.com
